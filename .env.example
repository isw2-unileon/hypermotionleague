# =============================================================================
# HyperMotion League - Environment Variables
# File used as a template for .env file. Copy this file to .env and fill in the values.
# =============================================================================

# Server
PORT=8080
GIN_MODE=debug
# Comma-separated list of allowed origins. Use explicit domains, never *.
CORS_ALLOW_ORIGINS=https://hypermotionleague.vercel.app,http://localhost:5173

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
#
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Replace [PASSWORD] and [PROJECT-REF] with your actual Supabase credentials. 

