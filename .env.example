# =============================================================================
# HyperMotion League - Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# Server
PORT=8080
GIN_MODE=debug

# CORS: comma-separated list of allowed origins (no wildcards in production).
CORS_ALLOW_ORIGINS=https://hypermotionleague.vercel.app,http://localhost:5173

# =============================================================================
# Auth / JWT
# =============================================================================
# REQUIRED. Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Full connection string (takes precedence over individual DB_* fields).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Individual fields (used only if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=hypermotionleague
# DB_SSLMODE=require

# =============================================================================
# Supabase (OAuth + service operations)
# =============================================================================
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# WARNING: This is a service-role key — backend only, never expose to the client.
SUPABASE_SERVICE_KEY=

# =============================================================================
# External APIs (optional — only needed by the sync-players command)
# =============================================================================
API_FOOTBALL_KEY=
