# Frontend environment variables (Vite). Copy to `.env` for local dev and set
# the same names in your Vercel project settings for production.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Backend API base URL.
# - Production (Vercel): the full public Render URL, NO trailing slash, e.g.
#     VITE_API_URL=https://your-backend.onrender.com
# - Local dev: leave UNSET (or empty) so requests stay relative and hit the
#   Vite dev proxy configured in vite.config.ts.
VITE_API_URL=

# Supabase (used by src/lib/supabase.ts for OAuth). Required for the auth flow.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
